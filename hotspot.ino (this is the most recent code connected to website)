#include <WiFi.h>
#include <Wire.h>
#include "Adafruit_MPR121.h"

const char* ssid = "Annie-ESP32-Access-Point";
const char* password = "123456789";

WiFiServer server(80);
String header;
String output27State = "off";

const int motorPin = 13;  // Motor (PWM)
const int heatPin = 26;   // Heat
const int touchPad = 5;   // MPR121 Capacitive Pad Number

IPAddress local_IP(192,168,1,1);
IPAddress gateway(192,168,1,1);
IPAddress subnet(255,255,255,0);

Adafruit_MPR121 cap = Adafruit_MPR121();
uint16_t lastTouched = 0;
uint16_t currTouched = 0;

int motorIntensity = 0; // 0 (off) to 10 (full power)
bool motorState = false; // True = ON, False = OFF

void setup() {
    Serial.begin(115200);

    pinMode(motorPin, OUTPUT);
    pinMode(heatPin, OUTPUT);
    analogWrite(motorPin, 0);   // Start with motor OFF
    digitalWrite(heatPin, LOW); // Start with heat OFF

    WiFi.softAPConfig(local_IP, gateway, subnet);
    WiFi.softAP(ssid, password);

    Serial.print("AP IP address: ");
    Serial.println(WiFi.softAPIP());

    server.begin();

    // Initialize MPR121
    if (!cap.begin(0x5A)) {
        Serial.println("MPR121 not found, check wiring!");
        while (1);
    }
    Serial.println("MPR121 found!");
}

void loop() {
    WiFiClient client = server.available();
    
    // Handle Web Client Requests
    if (client) {
        Serial.println("New Client.");
        String currentLine = "";
        while (client.connected()) {
            if (client.available()) {
                char c = client.read();
                Serial.write(c);
                header += c;
                if (c == '\n') {
                    if (currentLine.length() == 0) {
                        client.println("HTTP/1.1 200 OK");
                        client.println("Content-type:text/html");
                        client.println("Connection: close");
                        client.println();

                        // Handle Motor Intensity Slider
                        if (header.indexOf("GET /motor?value=") >= 0) {
                            int valueIndex = header.indexOf("GET /motor?value=") + 17;
                            int intensity = header.substring(valueIndex, valueIndex + 2).toInt();
                            if (intensity >= 0 && intensity <= 10) {
                                motorIntensity = intensity;
                                int pwmValue = map(motorIntensity, 0, 10, 255, 0); // Fix inverted PWM
                                analogWrite(motorPin, pwmValue);
                                Serial.print("Motor Intensity: ");
                                Serial.println(motorIntensity);
                            }
                        }

                        // Handle Heat Toggle
                        if (header.indexOf("GET /27/on") >= 0) {
                            Serial.println("Heat ON");
                            digitalWrite(heatPin, HIGH);
                            output27State = "on";
                        } else if (header.indexOf("GET /27/off") >= 0) {
                            Serial.println("Heat OFF");
                            digitalWrite(heatPin, LOW);
                            output27State = "off";
                        }

                        // Start HTML Page
                        client.println("<!DOCTYPE html><html>");
                        client.println("<head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">");
                        client.println("<style>html { font-family: Helvetica; text-align: center;}");
                        client.println(".button { background-color: #4CAF50; border: none; color: white; padding: 16px 40px; font-size: 30px; cursor: pointer;}");
                        client.println(".button2 {background-color: #555555;} ");
                        client.println(".slider { width: 80%; }");
                        client.println("</style></head>");
                        
                        client.println("<body><h1>HeadHush</h1>");

                        // Motor Intensity Slider
                        client.println("<p>Vibration Intensity: <span id='motorValue'>" + String(motorIntensity) + "</span></p>");
                        client.println("<input type='range' min='0' max='10' value='" + String(motorIntensity) + "' class='slider' id='motorSlider' oninput='updateMotor(this.value)'>");

                        // Heat Toggle
                        client.println("<p>Heat: " + output27State + "</p>");
                        if (output27State == "off") {
                            client.println("<p><a href=\"/27/on\"><button class=\"button\">ON</button></a></p>");
                        } else {
                            client.println("<p><a href=\"/27/off\"><button class=\"button button2\">OFF</button></a></p>");
                        }

                        // JavaScript to Send Slider Data
                        client.println("<script>");
                        client.println("function updateMotor(value) {");
                        client.println("document.getElementById('motorValue').innerText = value;");
                        client.println("var xhr = new XMLHttpRequest();");
                        client.println("xhr.open('GET', '/motor?value=' + value, true);");
                        client.println("xhr.send(); }");
                        client.println("</script>");

                        client.println("</body></html>");
                        client.println();
                        break;
                    } else {
                        currentLine = "";
                    }
                } else if (c != '\r') {
                    currentLine += c;
                }
            }
        }
        header = "";
        client.stop();
        Serial.println("Client disconnected.");
    }

    // Handle Capacitive Touch Sensor
    currTouched = cap.touched();
    
    // Check if the conductive fabric (pad 5) is pressed
    if ((currTouched & _BV(touchPad)) && !(lastTouched & _BV(touchPad))) {
        Serial.println("Touch Detected - Toggling Motor");
        motorState = !motorState; // Toggle motor state

        if (motorState) {
            motorIntensity = 10; // Full Power when turned on
        } else {
            motorIntensity = 0; // Fully Off
        }

        int pwmValue = map(motorIntensity, 0, 10, 255, 0); // Fix PWM inversion
        analogWrite(motorPin, pwmValue);

        Serial.print("Motor New State: ");
        Serial.println(motorState ? "ON (10)" : "OFF (0)");
    }
 
    lastTouched = currTouched;
}
